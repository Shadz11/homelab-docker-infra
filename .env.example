# =============================================================================
# Self-Hosted Private Cloud & Backup Homelab — Environment Configuration
# Copy to .env before running `docker compose up -d`:
#   cp .env.example .env
# =============================================================================

# Linux User / Group IDs for least-privilege container file ownership
PUID=1000
PGID=1000

# System Timezone
TZ=Australia/Sydney

# Persistent Application State & Metadata Directory (SSD / NVMe recommended)
CONFIG_DIR=/srv/homelab/config

# Primary Private Cloud & NAS Storage Pool (Family files, documents & photos)
CLOUD_DATA_DIR=/mnt/storage/cloud

# Read-Only Family Vault Archive (Mounted strictly :ro to prevent accidental modification)
ARCHIVE_VAULT_DIR=/mnt/storage/archive

# Secondary Media Storage Pool (Mounted strictly read-only :ro inside containers)
MEDIA_DIR=/mnt/storage/media

# Nightly Disaster Recovery Backup Destination for scripts/backup-config.sh
BACKUP_DIR=/srv/homelab/backups
RETENTION_DAYS=14
